// tsconfig.json
{
    "compilerOptions": {
        "lib": [
          "es2023"
        ],
        "module": "node16",
        "target": "es2022",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "outDir": "dist",
        "resolveJsonModule": true
    },
    "ts-node": {
        "esm": true,
        "experimentalSpecifierResolution": "node"
    },
    "exclude": [
        "artifacts",
        "node_modules"
    ],
    "files": [
        "./hardhat.config.ts"
    ],
    "include": [
        "artifacts/**/*",
        "artifacts/**/*.json",
        "scripts/**/*",
        "tasks/**/*",
        "test/**/*",
        "typechain/**/*",
        "types/**/*"
    ]
}